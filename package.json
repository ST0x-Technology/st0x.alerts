{
	"name": "sft-template",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"nix-dev": "nix develop --extra-experimental-features nix-command --extra-experimental-features flakes",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"lint": "eslint --fix src",
		"lint-check": "eslint src",
		"format-check": "prettier --list-different src",
		"svelte-lint-format-check": "npm run lint-check && npm run format-check"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.0",
		"@testing-library/jest-dom": "^6.4.5",
		"@testing-library/svelte": "^5.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/eslint": "8.56.0",
		"@types/lodash-es": "^4.17.12",
		"@types/pako": "^2.0.3",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"@vitest/ui": "^1.6.0",
		"autoprefixer": "^10.4.17",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"jsdom": "^24.0.0",
		"postcss": "^8.4.33",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.2",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.4.1",
		"typescript": "^5.4.3",
		"typescript-eslint": "^7.3.1",
		"vite": "^5.0.3",
		"vitest": "^1.6.0"
	},
	"type": "module",
	"dependencies": {
		"@exodus/schemasafe": "^1.3.0",
		"@metamask/jazzicon": "^2.0.0",
		"@octokit/core": "^6.0.1",
		"@popperjs/core": "^2.11.8",
		"@raugfer/jazzicon": "^1.0.6",
		"@sentry/sveltekit": "^8.26.0",
		"@tanstack/svelte-query": "^5.17.19",
		"@tenderly/actions": "^0.2.215",
		"@wagmi/connectors": "^5.0.14",
		"@wagmi/core": "^2.6.17",
		"axios": "^1.6.7",
		"cbor-web": "^9.0.1",
		"ethers": "^6.10.0",
		"flowbite": "^2.2.1",
		"flowbite-svelte": "^0.44.22",
		"flowbite-svelte-icons": "^1.0.2",
		"lightweight-charts": "^4.1.3",
		"lodash-es": "^4.17.21",
		"moment": "^2.30.1",
		"pako": "^2.1.0",
		"pinata-web3": "^0.4.1",
		"svelte-copy": "^1.4.1",
		"svelte-jsoneditor": "^0.21.6",
		"svelte-wagmi": "1.0.7",
